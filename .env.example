OPENAI_API_KEY=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appVpG2TxVhrz8muZ
GHOSTOS_WEBHOOK_SECRET=
GHOSTOS_MODEL=gpt-5.6-sol

# Provider-neutral RELAY outbound gateway. For the built-in Twilio adapter this should
# point to the deployed server-side /api/relay-provider/twilio endpoint.
RELAY_OUTBOUND_WEBHOOK_URL=
RELAY_OUTBOUND_WEBHOOK_SECRET=

# Twilio credentials are server-side only. Configure either a Messaging Service SID
# (preferred) or a Twilio From number, not both unless you intentionally want fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# These must be the exact public HTTPS URLs configured in Twilio so request-signature
# validation uses the same URL Twilio signed.
TWILIO_STATUS_CALLBACK_URL=
TWILIO_INBOUND_WEBHOOK_URL=
