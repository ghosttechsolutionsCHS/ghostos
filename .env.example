OPENAI_API_KEY=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appVpG2TxVhrz8muZ
GHOSTOS_WEBHOOK_SECRET=
GHOSTOS_MODEL=gpt-5.6-sol

# RELAY provider-neutral outbound gateway.
# GhostOS POSTs customer messages here. Provider-specific credentials (for example Twilio)
# belong in the gateway/provider environment, never in browser code or Airtable.
# Success response contract:
# {"ok":true,"provider":"twilio","messageId":"...","status":"accepted|sent|delivered","timestamp":"ISO-8601"}
# A 2xx response without ok=true + messageId + a confirmed status is treated as failure.
RELAY_OUTBOUND_WEBHOOK_URL=

# Shared server-side secret sent as x-ghostos-relay-secret to the outbound gateway and
# required on POST /api/relay-callback for delivery-status and opt-out callbacks.
RELAY_OUTBOUND_WEBHOOK_SECRET=
